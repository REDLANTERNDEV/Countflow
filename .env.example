# Copy to .env for a production deployment:
#   docker compose -f compose.yaml -f compose.prod.yaml up -d
#
# Local development needs none of this — compose.override.yaml supplies
# development defaults automatically.

# Database password. Required in production.
POSTGRES_PASSWORD=change-me

# JWT signing key. Required in production. At least 32 bytes.
#   openssl rand -base64 48
JWT_SIGNING_KEY=change-me-at-least-32-bytes-long-for-hs256

# Hostname Caddy serves. A real hostname makes it provision TLS automatically;
# ":80" serves plain HTTP.
CADDY_SITE_ADDRESS=countflow.example.com

# Seq admin password. Required in production; the dev stack runs Seq open.
SEQ_ADMIN_PASSWORD=change-me

# Demo seeding. Leave false in production — true creates known-password accounts.
SEED_DEMO_USERS=false
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=Countflow#2026

# Host port for the web edge in the default (non-production) stack.
WEB_PORT=8000
