{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      // 8080 everywhere: it is what the container listens on, what compose
      // publishes, and what both Vite dev proxies target. A different port here
      // would mean `dotnet run` and `docker compose up` need different frontend
      // configuration for no reason.
      "applicationUrl": "http://localhost:8080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
