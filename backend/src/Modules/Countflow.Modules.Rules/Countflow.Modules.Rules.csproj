<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- SharedKernel only. The rules engine reads items, locations and stock
         through the contracts in SharedKernel.Contracts; it has no project
         reference to MasterData or Inventory, so slotting cannot quietly start
         reading somebody else's tables (ADR 0002). -->
    <ProjectReference Include="../../Countflow.SharedKernel/Countflow.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
