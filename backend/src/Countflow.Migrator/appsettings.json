{
  "ConnectionStrings": {
    "Countflow": "Host=localhost;Port=5432;Database=countflow;Username=countflow;Password=countflow"
  },
  "Seed": {
    "DemoUsers": false,
    "DemoData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",

      // On a fresh database EF probes each module's __EFMigrationsHistory table
      // before the schema exists. The command legitimately fails, EF recovers and
      // treats it as "nothing applied yet" — but logs it at Error, so a perfectly
      // successful first run prints several `fail:` lines. That teaches whoever
      // watches these logs to ignore `fail:`, which is the opposite of useful.
      //
      // Nothing is lost by silencing it here: a migration that genuinely fails
      // throws, and Program.cs logs it as Critical with the exception and exits 1.
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  }
}
