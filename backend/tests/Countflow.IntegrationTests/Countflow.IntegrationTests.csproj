<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Api only. Referencing the migrator too would put two top-level `Program`
         types in scope and make WebApplicationFactory<Program> ambiguous; the
         tests apply migrations through IModuleDbContext anyway. -->
    <ProjectReference Include="../../src/Countflow.Api/Countflow.Api.csproj" />
    <!-- The simulator, because Phase 6's acceptance test is "build a realistic
         warehouse and show the machine catching the class of bug three container
         runs caught by hand". It has no top-level statements, so it brings no
         second `Program` into scope. -->
    <ProjectReference Include="../../src/Countflow.Simulator/Countflow.Simulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
